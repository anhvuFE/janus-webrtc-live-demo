# Copy to .env.local and adjust if your Janus runs elsewhere.

# Janus WebSocket API endpoint (the docker-compose service).
NEXT_PUBLIC_JANUS_WS=ws://localhost:8188

# VideoRoom id the presenter publishes into / viewers subscribe to.
NEXT_PUBLIC_JANUS_ROOM=1234

# Optional TURN server for real NAT traversal (matches coturn/turnserver.conf).
# Leave blank for local single-machine testing.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=januswebrtc
NEXT_PUBLIC_TURN_PASS=demo-turn-secret
